{
  "compilerOptions": {
    // Solo chequeamos tipos: Node ejecuta los .ts directamente
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Cada archivo es un módulo aparte (así no chocan nombres entre ejercicios)
    "moduleDetection": "force",
    // Prohíbe sintaxis que Node no puede "borrar": enum, namespace, parameter properties
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
